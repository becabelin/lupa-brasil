# Senha do painel /admin (padrão: admin2026)
ADMIN_PASSWORD=admin2026

# Chave da OpenAI para análise dos planos
OPENAI_API_KEY=

# Modelo opcional (padrão: gpt-4o-mini)
# AI_MODEL=gpt-4o-mini

# URL pública canônica (SEO, OG, sitemap, JSON-LD)
# Ex.: https://lupadobrasil.com.br
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com

# Rate limit das perguntas por IA (/api/ask) — por IP e teto global
# ASK_LIMIT_PER_MIN=3
# ASK_LIMIT_PER_HOUR=12
# ASK_LIMIT_PER_DAY=30
# ASK_GLOBAL_DAY=400
# Cache de pergunta idêntica (minutos)
# ASK_CACHE_TTL_MIN=15
